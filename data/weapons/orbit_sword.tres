kind = 1
value = 0.15
weight = 0.6

[sub_resource type="Resource" id="Upgrade_sword_cooldown"]
script = ExtResource("90_upgrade")
id = &"sword_cooldown"
stat = &"cooldown"
kind = 1
value = -0.1
weight = 0.8

[resource]
script = ExtResource("1_script")
id = &"orbit_sword"
name_key = "WEAPON_ORBIT_SWORD_NAME"
description_key = "WEAPON_ORBIT_SWORD_DESC"
icon = ExtResource("4_icon")
tags = Array[StringName]([&"melee", &"blade"])
element = &"physical"
default_unlocked = true
base_stats = {
&"amount": 1.0,
&"cooldown": 5.0,
&"damage": 40.0,
&"duration": 3.0,
&"hit_interval": 0.5,
&"orbit_speed": 3.0,
&"projectile_radius": 12.0,
&"range": 56.0
}
stat_limits = {
&"amount": Vector2(1, 6),
&"cooldown": Vector2(2, 99)
}
behavior = SubResource("Resource_behavior")
projectile_texture = ExtResource("3_blade")
frame_width = 32
animation_fps = 1.0
upgrades = Array[ExtResource("90_upgrade")]([SubResource("Upgrade_sword_damage"), SubResource("Upgrade_sword_amount"), SubResource("Upgrade_sword_duration"), SubResource("Upgrade_sword_orbit_speed"), SubResource("Upgrade_sword_cooldown")])
