[resource]
script = ExtResource("1_script")
id = &"arcane_wand"
name_key = "WEAPON_ARCANE_WAND_NAME"
description_key = "WEAPON_ARCANE_WAND_DESC"
icon = ExtResource("5_icon")
tags = Array[StringName]([&"projectile", &"magic"])
element = &"physical"
default_unlocked = true
base_stats = {
&"amount": 1.0,
&"cooldown": 0.8,
&"damage": 50.0,
&"pierce": 1.0,
&"projectile_lifetime": 1.5,
&"projectile_radius": 4.0,
&"projectile_speed": 260.0,
&"range": 220.0
}
stat_limits = {
&"amount": Vector2(1, 5),
&"cooldown": Vector2(0.25, 0.8)
}
behavior = SubResource("Resource_behavior")
target_picker = SubResource("Resource_picker")
projectile_texture = ExtResource("4_bolt")
frame_width = 16
animation_fps = 10.0
upgrades = Array[ExtResource("90_upgrade")]([SubResource("Upgrade_wand_damage"), SubResource("Upgrade_wand_cooldown"), SubResource("Upgrade_wand_amount"), SubResource("Upgrade_wand_pierce"), SubResource("Upgrade_wand_speed"), SubResource("Upgrade_wand_ricochet")])
