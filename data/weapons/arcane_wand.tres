[gd_resource type="Resource" script_class="WeaponData" format=3]

[ext_resource type="Script" path="res://scripts/weapons/weapon_data.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/weapons/behaviors/projectile_behavior.gd" id="2_behavior"]
[ext_resource type="Script" path="res://scripts/weapons/targeting/nearest_distinct_picker.gd" id="3_picker"]
